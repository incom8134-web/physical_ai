# Images, video and fonts are binary: never diff, merge or convert line endings.
# They are stored as ordinary files (no Git LFS), so Vercel deploys the real
# bytes and every clone stays clean.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.mp4    binary
*.webm   binary
*.woff   binary
*.woff2  binary
